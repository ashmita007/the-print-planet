# ============================================================
# The Print Planet - Environment Configuration Template
# ============================================================

# Database (PostgreSQL - Render provides DATABASE_URL automatically)
DATABASE_URL=postgresql://printplanet:password@dpg-xxxxx-a.oregon-postgres.render.com/the_print_planet
POSTGRES_DB=the_print_planet
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432
USE_SQLITE=False

# Django Backend
DJANGO_SECRET_KEY=generate-a-secure-production-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# CORS & CSRF
CSRF_TRUSTED_ORIGINS=https://*.onrender.com
CORS_ALLOWED_ORIGINS=https://the-print-planet-frontend.onrender.com

# Initial Owner Admin Bootstrap
CREATE_DEFAULT_OWNER=True
OWNER_USERNAME=admin
OWNER_EMAIL=owner@theprintplanet.in
OWNER_PASSWORD=AdminPass123!Secure

# Cloudinary Image Management (Set either CLOUDINARY_URL or the 3 individual keys)
# Copy from Cloudinary Dashboard -> Programmable Media -> API Keys
CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Next.js Frontend
NEXT_PUBLIC_API_URL=https://the-print-planet-backend.onrender.com
INTERNAL_API_URL=https://the-print-planet-backend.onrender.com
