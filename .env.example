# ============================================================
# The Print Planet - Environment Configuration Template
# ============================================================

# Database (PostgreSQL - Render provides DATABASE_URL automatically)
DATABASE_URL=postgresql://printplanet:password@dpg-xxxxx-a.oregon-postgres.render.com/the_print_planet
POSTGRES_DB=the_print_planet
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432
USE_SQLITE=False

# Django Backend
DJANGO_SECRET_KEY=generate-a-secure-production-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# CORS & CSRF
CSRF_TRUSTED_ORIGINS=https://*.onrender.com
CORS_ALLOWED_ORIGINS=https://the-print-planet-frontend.onrender.com

# Initial Owner Admin Bootstrap
CREATE_DEFAULT_OWNER=True
OWNER_USERNAME=admin
OWNER_EMAIL=owner@theprintplanet.in
OWNER_PASSWORD=AdminPass123!Secure

# Cloudflare R2 Object Storage (10GB Free, 0 Egress Fees)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=the-print-planet
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# Email Notifications (HTTPS APIs are required on Render free tier; SMTP ports are blocked)
# EMAIL_PROVIDER: resend or brevo (leave empty for automatic fallback)
EMAIL_PROVIDER=resend
OWNER_NOTIFICATION_EMAIL=theprintplanet01@gmail.com

# Resend (recommended): 3,000 emails/month free
# Sign up with theprintplanet01@gmail.com, then create an API key.
# Leave RESEND_FROM_EMAIL unset to use the sandbox sender for owner alerts.
# After verifying theprintplanet.co.in in Resend > Domains, set:
# RESEND_FROM_EMAIL=The Print Planet <notifications@theprintplanet.co.in>
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Brevo fallback (300 emails/day free; sender must be verified)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=theprintplanet01@gmail.com

# Legacy SMTP (will not work on Render free tier)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Cloudinary Image Management (Optional secondary CDN)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Next.js Frontend
NEXT_PUBLIC_API_URL=https://the-print-planet-backend.onrender.com
INTERNAL_API_URL=https://the-print-planet-backend.onrender.com
