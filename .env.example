# ============================================================
# The Print Planet - Environment Configuration Template
# ============================================================

# Database (PostgreSQL)
POSTGRES_DB=the_print_planet
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432
USE_SQLITE=False

# Django Backend
DJANGO_SECRET_KEY=generate-a-secure-production-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# Initial Owner Admin Bootstrap
CREATE_DEFAULT_OWNER=True
OWNER_USERNAME=admin
OWNER_EMAIL=owner@theprintplanet.in
OWNER_PASSWORD=AdminPass123!Secure

# Cloudinary Image Management (Managed Service)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000
